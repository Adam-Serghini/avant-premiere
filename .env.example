# Clé TMDB : https://www.themoviedb.org/settings/api
# (« Clé d'API » ou « Jeton d'accès en lecture à l'API », les deux fonctionnent)
TMDB_API_KEY=
# Clé OMDb (facultative) pour afficher les notes IMDb, Rotten Tomatoes et Metacritic : https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Port local de Avant-Première
PORT=4321
